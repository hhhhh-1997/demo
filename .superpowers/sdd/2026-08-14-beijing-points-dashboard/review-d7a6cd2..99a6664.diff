+  ({ id, name: 'N' + id, birth, unit, score, age: 2026 - Number(birth.slice(0, 4)) })
+
+const records: Record[] = [
+  rec('1', '1980-01', 'A公司', 130),
+  rec('2', '1982-05', 'A公司', 120),
+  rec('3', '1982-08', 'B公司', 140),
