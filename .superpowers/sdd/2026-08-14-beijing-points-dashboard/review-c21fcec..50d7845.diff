+<script setup lang="ts">
+import { computed } from 'vue'
+import { useData } from '../stores/useData'
+import ChartBox from './ChartBox.vue'
+import { summarize, scoreDistribution } from '../utils/stats'
+import type { EChartsOption } from 'echarts'
+
+const { records } = useData()
+
+const kpi = computed(() => {
+  if (!records.value.length) return null
+  const s = summarize(records.value)
+  return {
+    scoreMax: s.scoreMax,
+    scoreMin: s.scoreMin,
+    scoreAvg: s.scoreAvg,
+    scoreMedian: s.scoreMedian,
+    total: s.total,
+  }
+})
+
+const buckets = computed(() => scoreDistribution(records.value, 2))
+
+const maxCount = computed(() => buckets.value.reduce((m, b) => Math.max(m, b.count), 0))
+
+const option = computed<EChartsOption>(() => ({
+  grid: { left: 48, right: 16, top: 24, bottom: 40 },
+  xAxis: { type: 'category', data: buckets.value.map(d => d.label), axisLabel: { interval: 0 } },
+  yAxis: { type: 'value' },
+  tooltip: { trigger: 'axis' },
+  series: [{
+    type: 'bar', barMaxWidth: 24,
+    data: buckets.value.map(d => ({
+      value: d.count,
+      itemStyle: { color: d.count === maxCount.value ? '#2C7CF5' : '#7BA9E8' },
+    })),
+  }],
+}))
+</script>
+
+<template>
+  <template v-if="kpi">
+    <div class="stat-strip cols-4">
+      <div class="stat"><div class="s-label">最高积分</div><div class="s-value num">{{ kpi.scoreMax.toFixed(2) }}<span class="unit">分</span></div></div>
+      <div class="stat"><div class="s-label">最低积分</div><div class="s-value num">{{ kpi.scoreMin.toFixed(2) }}<span class="unit">分</span></div></div>
+      <div class="stat"><div class="s-label">平均积分</div><div class="s-value num">{{ kpi.scoreAvg.toFixed(2) }}<span class="unit">分</span></div></div>
+      <div class="stat"><div class="s-label">积分中位数</div><div class="s-value num">{{ kpi.scoreMedian.toFixed(2) }}<span class="unit">分</span></div></div>
+    </div>
+
+    <div class="card">
+      <div class="card-head">
+        <h2 class="card-title">积分分布直方图</h2>
+        <div class="legend"><span class="sw a"></span>人数最多<span class="sw g"></span>其他</div>
+      </div>
+      <div class="chart-box">
+        <ChartBox :option="option" />
+      </div>
+    </div>
+
+    <div class="card">
+      <div class="card-head"><h2 class="card-title">分数段统计</h2></div>
+      <div class="table-wrap">
+        <table>
+          <thead>
+            <tr><th>分数段</th><th class="r">人数</th><th class="r">占比</th><th style="width:38%;">分布</th></tr>
+          </thead>
+          <tbody>
+            <tr v-for="b in buckets" :key="b.label">
+              <td class="mono" style="font-size:var(--text-13);">{{ b.label }}</td>
+              <td class="r"><span class="score">{{ b.count }}</span></td>
+              <td class="r num">{{ (b.count / kpi.total * 100).toFixed(1) }}%</td>
+              <td>
+                <div style="background:var(--chart-track);border-radius:4px;height:8px;overflow:hidden;">
+                  <div :style="{
+                    width: (b.count / maxCount * 100) + '%',
+                    height: '100%',
+                    background: b.count === maxCount ? 'var(--color-primary)' : 'var(--chart-bar)',
+                    borderRadius: '4px',
+                  }"></div>
+                </div>
+              </td>
+            </tr>
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </template>
+</template>
